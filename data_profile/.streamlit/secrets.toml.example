# Copy this file to .streamlit/secrets.toml and fill in your Databricks credentials
# WARNING: .streamlit/secrets.toml should NEVER be committed to git
# It contains sensitive credentials

DATABRICKS_HOST = "https://dbc-xxxxxxxx.cloud.databricks.com"
DATABRICKS_CLIENT_ID = "xxxxxxxxxxxxxxxx"
DATABRICKS_CLIENT_SECRET = "xxxxxxxxxxxxxxxx"
